{
  "name": "@curvenote/scms-sites-ext",
  "private": true,
  "version": "0.25.0",
  "description": "Sites extension for Curvenote SCMS applications",
  "author": "Rowan Cockett <rowan@curvenote.com>",
  "homepage": "https://github.com/curvenote/curvenote",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "browser": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "development": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curvenote/curvenote.git"
  },
  "scripts": {
    "prepush": "bun run lint:format:fix; bun run lint:circular; bun run lint; bun run compile; bun run test:ci; bun run test:unit; bun run test:integration",
    "pp": "bun run prepush",
    "clean": "rimraf dist _build api && find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "lint": "bunx eslint -c .eslintrc.cjs \"src/**/*.{ts,tsx}\"",
    "lint:format": "bunx prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:format:fix": "bunx prettier --write \"src/**/*.{ts,tsx}\"",
    "lint:circular": "bunx madge --circular --extensions ts,tsx src",
    "config": "bunx @app-config/cli@2 generate",
    "build": "bun run build:server && bun run build:client",
    "build:server": "tsc --project tsconfig.json",
    "build:client": "tsup",
    "dev": "tsc -w",
    "compile": "tsc --noEmit",
    "format": "bunx prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version": "changeset version && bun install"
  },
  "bugs": {
    "url": "https://github.com/curvenote/curvenote/issues"
  },
  "dependencies": {
    "@codemirror/view": "^6.35.0",
    "@curvenote/check-definitions": "^0.17.2",
    "@curvenote/common": "^0.7.0",
    "@curvenote/icons": "0.0.4",
    "@curvenote/scms-core": "0.25.0",
    "@curvenote/scms-server": "0.25.0",
    "@curvenote/scms-db": "0.25.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@react-router/dev": "7.18.2",
    "@scienceicons/react": "^0.0.13",
    "classnames": "^2.5.1",
    "color": "^5.0.2",
    "date-fns": "3.6.0",
    "doi-utils": "^2.0.5",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.18.0",
    "myst-common": "^1.9.3",
    "myst-config": "^1.9.3",
    "myst-to-react": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "sonner": "^2.0.7",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.12",
    "zod-form-data": "^3.0.1",
    "@react-router/node": "7.18.2",
    "react-day-picker": "8"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0",
    "@rollup/rollup-linux-x64-gnu": "^4.35.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@react-router/serve": "7.18.2",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/color": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.19.0",
    "@types/nprogress": "^0.2.3",
    "@types/numeral": "^2.0.5",
    "@types/react": "^18.3.18",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint-config-curvenote": "^0.0.4",
    "glob": "^11.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.0",
    "prettier-eslint": "^16.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.6",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.10"
}
