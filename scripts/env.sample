SCMS_TOKEN=service-account-token
SCMS_BASE_URL=http://localhost:3031
SCMS_SITE=etl-benchmark
ETL_REGISTRATIONS=10
ETL_ROOTS=4
ETL_DRY_RUN=0

# DOI prefix: each run appends a unique run id by default (fresh DOIs every benchmark)
ETL_PREFIX=10.5072/etl-bench
# ETL_RUN_ID=my-run-01
# ETL_RANDOMIZE_PREFIX=0
# ETL_PROGRESS_EVERY=100
# ETL_PROGRESS_INTERVAL=15

# Payload fixtures
# ETL_METADATA=scripts/fixtures/workversion.json
# ETL_SUBMISSION_METADATA=scripts/fixtures/submissionversion.json

# Postgres traffic monitor for etl-register-works.sh
ETL_MONITOR_PG_TRAFFIC=1
ETL_PG_PORT=5432

# One-time sudo setup (run once, then no password prompts):
#   ./scripts/etl-register-works.sh --setup-sudo

# Standalone live monitor (scripts/monitor-pg-traffic.sh)
PG_PORT=5432
INTERVAL=1
