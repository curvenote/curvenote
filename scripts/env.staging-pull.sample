# Copy to scripts/.env (or export in your shell). scripts/pull-staging-site-data.sh loads scripts/.env.

# Remote Supabase / staging Postgres (Session pooler or direct connection)
STAGING_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Set to 1 if TLS fails against Supabase from your machine (dev only)
# STAGING_DATABASE_SSL_INSECURE=1

# Local dev DB (same as platform/scms .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scms

# Defaults (override via CLI flags)
PULL_SOURCE_SITE=openrxiv
PULL_TARGET_SITE=openrxiv
PULL_LIMIT=1000

# PULL_DRY_RUN=1
# PULL_REPLACE=1
# PULL_NO_ACTIVITY=1
# PULL_NO_JOBS=1
# PULL_NO_CHECKS=1
