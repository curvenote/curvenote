{
  "name": "@curvenote/cdn",
  "version": "0.6.1",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curvenote/curvenote.git"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "lint": "bunx eslint \"src/**/!(*.spec).ts*\" -c ./.eslintrc.cjs",
    "lint:format": "bunx prettier --check \"src/**/*.{ts,tsx,md}\"",
    "lint:format:fix": "bunx prettier --write \"src/**/*.{ts,tsx,md}\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "dev": "bun run build:esm -- --watch",
    "build:esm": "tsc",
    "build": "bun run clean && bun run build:esm"
  },
  "dependencies": {
    "@curvenote/common": "^0.6.1",
    "cache-manager": "^5.2.3",
    "doi-utils": "^2.0.5",
    "myst-common": "^1.10.0",
    "myst-config": "^1.10.0",
    "myst-frontmatter": "^1.10.0",
    "myst-migrate": "^1.10.1",
    "myst-spec": "^0.0.5",
    "myst-spec-ext": "^1.10.0",
    "nbtx": "^0.2.3",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "unist-util-select": "^4.0.3"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
