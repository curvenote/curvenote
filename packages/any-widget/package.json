{
  "name": "@curvenote/any-widget",
  "version": "0.2.4",
  "description": "Extension interface and NodeRenderer following the `any-widget` interfaces",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "tsc --noEmit",
    "build:esm": "tsc",
    "build:plugin": "tsup",
    "build": "bun run clean && (bun run build:esm & bun run build:plugin & wait)",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/curvenote/curvenote"
  },
  "keywords": [
    "any-widget",
    "Curvenote",
    "MyST Markdown",
    "React"
  ],
  "author": "Steve Purves <steve@curvenote.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "myst-common": "^1.10.0",
    "react": "^18.3.1",
    "unist-builder": "^4.0.0",
    "vfile": "^5.0.0"
  },
  "devDependencies": {
    "@myst-theme/providers": "^1.3.1",
    "@types/react": "^18.3.12",
    "cpx": "^1.5.0",
    "tsup": "^8.1.0"
  }
}
