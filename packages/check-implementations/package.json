{
  "name": "@curvenote/check-implementations",
  "description": "Implementations for Curvenote checks",
  "author": "Franklin Koch <franklin@curvenote.com>",
  "version": "0.17.0",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curvenote/curvenote.git"
  },
  "scripts": {
    "clean": "rimraf dist",
    "lint": "bunx eslint \"src/**/*.ts*\" -c ./.eslintrc.cjs",
    "lint:format": "bunx prettier --check \"src/**/*.{ts,tsx,md}\"",
    "lint:format:fix": "bunx prettier --write \"src/**/*.{ts,tsx,md}\"",
    "build:esm": "tsc --outDir dist",
    "build": "bun run clean && bun run build:esm",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@curvenote/check-definitions": "^0.17.0",
    "@wordpress/wordcount": "^3.50.0",
    "credit-roles": "^2.1.0",
    "doi-utils": "^2.0.5",
    "lodash.isequal": "^4.5.0",
    "myst-cli": "^1.10.1",
    "myst-common": "^1.10.0",
    "myst-config": "^1.10.0",
    "myst-frontmatter": "^1.10.0",
    "myst-templates": "^1.0.27",
    "node-fetch": "^3.3.2",
    "p-limit": "^3.1.0",
    "simple-validators": "^1.2.0",
    "unist-util-select": "^4.0.3",
    "vfile": "^5.3.5"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/lodash.isequal": "^4.5.7",
    "@types/unist": "3.0.1",
    "@types/wordpress__wordcount": "^2.4.4"
  }
}
