{
  "name": "@curvenote/scms-tasks",
  "version": "0.24.3",
  "description": "SCMS tasks library: job client and helpers for cloud runners",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curvenote/curvenote.git"
  },
  "scripts": {
    "gcp-build": "bun run build",
    "clean": "rimraf dist",
    "build:esm": "tsc --outDir dist",
    "build": "bun run clean && bun run build:esm",
    "dev:esm": "tsc --outDir dist --watch",
    "dev": "bun run dev:esm",
    "lint": "bunx eslint \"src/**/*.ts\" -c ./.eslintrc.cjs",
    "lint:format": "bunx prettier --check \"src/**/*.ts\"",
    "lint:format:fix": "bunx prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@curvenote/common": "^0.7.0"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^22.9.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.21.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.1.3",
    "vitest": "^4.0.6"
  }
}
