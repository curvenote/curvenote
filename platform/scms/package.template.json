{
  "name": "@curvenote/scms",
  "private": true,
  "version": "0.25.0",
  "description": "Curvenote SCMS application and API",
  "author": "Rowan Cockett <rowan@curvenote.com>",
  "homepage": "https://github.com/curvenote/curvenote",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curvenote/curvenote.git"
  },
  "workspaces": [
    "../../mystmd/packages/*",
    "../../packages/*",
    "../../ee/*",
    "../../extensions/*/packages/*"
  ],
  "scripts": {
    "postinstall": "rm -rf ./node_modules/.prisma && ln -sfn ../../../node_modules/.prisma ./node_modules/.prisma",
    "prisma:generate": "bunx prisma generate --config=../../prisma.config.ts",
    "prisma:format": "bunx prisma format --config=../../prisma.config.ts",
    "db:studio": "prisma studio --config=../../prisma.config.ts",
    "minio:studio": "open http://127.0.0.1:9001",
    "dev:db:reset": "bunx prisma migrate reset --config=../../prisma.config.ts; bun run dev:db:seed",
    "dev:db:seed": "tsx ../../prisma/seed.mts",
    "dev:db:migrate": "bunx prisma migrate dev --config=../../prisma.config.ts",
    "test:db:reset": "dotenv -e .env.test -- bunx prisma migrate reset --force --config=../../prisma.test.config.ts",
    "config": "cd ../.. && bun run config",
    "compile": "NODE_ENV=development react-router typegen; tsc --noEmit",
    "optimize": "vite optimize",
    "build": "bun run build:dev",
    "build:prod": "react-router typegen; tsc; react-router build",
    "build:test": "react-router typegen; tsc; react-router build",
    "build:dev": "NODE_ENV=development react-router typegen; tsc; NODE_ENV=development react-router build",
    "dev": "react-router dev",
    "lint": "bunx eslint -c .eslintrc.cjs \"app/**/*.{ts,tsx}\"",
    "lint:format": "bunx prettier --check \"app/**/*.{ts,tsx}\" \"!app/extensions/client.ts\" \"!app/extensions/server.ts\"",
    "lint:circular": "madge -c app/*",
    "format": "bunx prettier --write \"**/*.{ts,tsx,md}\"",
    "bump:myst": "npm-upgrade-monorepo -w 'packages/*' 'myst-* @myst-theme/* @curvenote/*'",
    "data-migration:default-submission-kind": "dotenv -e .env -- tsx ../../prisma/migrations/20240123221351_default_submission_kind/data-migration.ts",
    "check-types": "NODE_ENV=development react-router typegen; tsc --noEmit",
    "typecheck": "NODE_ENV=development react-router typegen; tsc --noEmit",
    "compile:ci": "NODE_ENV=test react-router typegen; tsc --noEmit",
    "prepush": "bun run lint:format:fix; bun run lint:circular; bun run lint; bun run compile; bun run test:ci; bun run test:unit",
    "pp": "bun run prepush",
    "lint:format:fix": "bunx prettier --write \"app/**/*.{ts,tsx}\" \"!app/extensions/client.ts\" \"!app/extensions/server.ts\"",
    "test:integration": "bun run test:db:reset && dotenv -e .env.test -- vitest run --config vitest.config.integration.mjs",
    "test:unit": "dotenv -e .env.test -- vitest run --config vitest.config.unit.mjs",
    "test:ci": "dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:local": "dotenv -e .env.test -- vitest tests/e2e/e2e.spec.ts",
    "test:e2e": "dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:app:anon": "TEST_FILES=app.anon dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:app:admin": "TEST_FILES=app.admin dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:app:auth": "TEST_FILES=app.auth dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:app:disabled": "TEST_FILES=app.disabled dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:app:platform-admin": "TEST_FILES=app.platform-admin dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:app:pending": "TEST_FILES=app.pending dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:sites:user:site-admin": "TEST_FILES=sites.user.site-admin dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:sites:user:no-role": "TEST_FILES=sites.user.no-role dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:anon": "TEST_FILES=api.anon dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:auth": "TEST_FILES=api.auth dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:disabled": "TEST_FILES=api.disabled dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:all": "TEST_FILES=api.anon,api.auth,api.disabled,api.pending dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:security": "TEST_FILES=api.anon,api.disabled,api.pending dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:auth-tests": "TEST_FILES=api.auth dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:e2e:api:pending": "TEST_FILES=api.pending dotenv -e .env.test -- vitest run --config vitest.config.ci.mjs tests/e2e/e2e.spec.ts",
    "test:start-server": "dotenv -e .env.test -- react-router dev"
  },
  "devDependencies": {
    "@app-config/cli": "^2.8.7",
    "@changesets/cli": "^2.29.7",
    "@react-router/serve": "7.18.2",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/color": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/bmp-js": "^0.1.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.19.0",
    "@types/nprogress": "^0.2.3",
    "@types/numeral": "^2.0.5",
    "@types/react": "18.3.27",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^18.3.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^11.0.0",
    "docx": "^7.8.2",
    "esbuild": "^0.28.0",
    "eslint-config-curvenote": "^0.0.4",
    "glob": "^11.1.0",
    "madge": "^8.0.0",
    "npm-upgrade-monorepo": "^1.2.6",
    "npm-upgrade": "^3.3.0",
    "prettier": "^3.8.0",
    "prettier-eslint": "^16.3.0",
    "rimraf": "^3.0.2",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "turbo": "latest",
    "typescript": "^5.6.3",
    "vitest": "^4.0.6"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0",
    "@rollup/rollup-linux-x64-gnu": "^4.35.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.1"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.10"
  },
  "packageManager": "bun@1.3.10",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@app-config/config": "^2.8.7",
    "@app-config/main": "^2.8.7",
    "@app-config/vite": "^2.8.7",
    "@curvenote/blocks": "^1.6.3",
    "@curvenote/cdn": "^0.6.1",
    "@curvenote/check-definitions": "^0.16.0",
    "@curvenote/check-ui": "^0.6.9",
    "@curvenote/common": "^0.6.1",
    "@curvenote/icons": "^0.0.4",
    "@curvenote/remix-auth-okta": "^3.0.0",
    "@curvenote/scms-core": "*",
    "@curvenote/scms-doc-preview": "*",
    "@curvenote/scms-server": "*",
    "@curvenote/scms-db": "*",
    "@headlessui/tailwindcss": "^0.2.1",
    "@heroicons/react": "^2.2.0",
    "@myst-theme/providers": "^0.17.1",
    "@react-router/dev": "7.18.2",
    "@react-router/express": "7.18.2",
    "@react-router/node": "7.18.2",
    "@scienceicons/react": "^0.0.13",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.18",
    "@vercel/functions": "^3.1.4",
    "@vercel/react-router": "^1.2.3",
    "bmp-js": "^0.1.0",
    "classnames": "^2.5.1",
    "cron-parser": "^5.6.1",
    "cronstrue": "^3.24.0",
    "date-fns": "3.6.0",
    "doi-utils": "^2.0.5",
    "officeparser": "^6.0.4",
    "@napi-rs/canvas": "^0.1.100",
    "pdfjs-dist": "5.6.205",
    "fuse.js": "^7.1.0",
    "isbot": "^5",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.18.0",
    "myst-to-react": "^0.17.1",
    "nprogress": "^0.2.0",
    "p-limit": "^3.1.0",
    "react": "^18.3.1",
    "react-router": "7.18.2",
    "sharp": "^0.35.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^12.0.0",
    "uuidv7": "^1.0.2",
    "vite": "^7.1.12",
    "vite-plugin-restart": "^2.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.1.12",
    "zod-form-data": "^3.0.1"
  }
}
