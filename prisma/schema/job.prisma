enum JobStatus {
  BLOCKED
  QUEUED
  RUNNING
  SCHEDULED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobTriggerOn {
  SUCCESS
  FAILURE
}

model Job {
  id                String             @id
  date_created      String
  date_modified     String
  job_type          String
  status            JobStatus
  payload           Json
  scheduled_at      String?
  results           Json?
  messages          String[]
  follow_on         Json?
  invoked_by_id     String?
  activity_type     String?
  depends_on_job_id String?
  trigger_on        JobTriggerOn?
  depends_on        Job?               @relation("JobDependencies", fields: [depends_on_job_id], references: [id], onDelete: SetNull)
  dependents        Job[]              @relation("JobDependencies")
  invoked_by        User?              @relation(fields: [invoked_by_id], references: [id], onDelete: SetNull)
  SubmissionVersion SubmissionVersion?
  linkedJobs        LinkedJob[]

  @@index([depends_on_job_id, status, trigger_on])
  @@index([status, scheduled_at])
}

model LinkedJob {
  id              String      @id
  date_created    String
  job             Job         @relation(fields: [job_id], references: [id], onDelete: Cascade)
  job_id          String
  work_version    WorkVersion @relation(fields: [work_version_id], references: [id], onDelete: Cascade)
  work_version_id String

  @@index([work_version_id])
}
