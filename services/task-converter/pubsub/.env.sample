# Copy to .env in this directory, then run ./pubsub.sh from services/task-converter/pubsub/
# Get project number: gcloud projects describe PROJECT_ID --format='value(projectNumber)'
# PUSH_ENDPOINT: gcloud run services describe task-converter --region REGION --project PROJECT_ID --format='value(status.url)'

PROJECT_ID=
PROJECT_NUMBER=
REGION=us-central1
SERVICE_NAME=task-converter
PUSH_ENDPOINT=
TOPIC_NAME=scmsTaskConverterTopic
SUBSCRIPTION_NAME=scmsTaskConverterSub

# Optional
# SERVICE_ACCOUNT_NAME=check-pub-sub-invoker
# ACK_DEADLINE=600
