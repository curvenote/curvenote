{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "api/**", "public/build/**"]
    },
    "@curvenote/scms-db#build": {
      "inputs": ["../../prisma/**", "./src"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "@curvenote/scms#lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "app/extensions/client.ts", "app/extensions/server.ts"]
    },
    "lint:format": {
      "outputs": []
    },
    "@curvenote/scms#lint:format": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "app/extensions/client.ts", "app/extensions/server.ts"]
    },
    "lint:format:fix": {
      "outputs": []
    },
    "@curvenote/scms#lint:format:fix": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "app/extensions/client.ts", "app/extensions/server.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
